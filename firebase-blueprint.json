{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User chat conversation with Claude Fable or Gemini models",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "model": { "type": "string", "maxLength": 64 },
        "pinned": { "type": "boolean" },
        "isEncrypted": { "type": "boolean" },
        "encryptedData": { "type": "string", "maxLength": 1000000 },
        "preview": { "type": "string", "maxLength": 500 },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "model", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Chat sessions belonging to the authenticated user"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Connection verification document"
    }
  }
}
